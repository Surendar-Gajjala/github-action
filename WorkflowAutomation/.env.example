# Copy to .env and fill in real values. NEVER commit .env.
# These variables are read by the Spring Boot backend only; none are exposed to the React bundle.

# --- Integration modes: mock (default, no external calls) | live ---
OPENAI_MODE=mock
EMAIL_MODE=mock
GITHUB_MODE=mock

# --- OpenAI ---
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_ENABLED=true
COMPANY_NAME=Acme Corp

# --- SMTP email ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=onboarding@example.com
MAIL_FROM_NAME=Onboarding Team

# --- GitHub (fine-grained PAT with only "Issues: Read and write" on the onboarding repository) ---
GITHUB_TOKEN=replace-with-fine-grained-personal-access-token
GITHUB_DEFAULT_OWNER=your-org
GITHUB_DEFAULT_REPOSITORY=onboarding

# --- Database (defaults to embedded H2 file database when unset) ---
# H2 (default):   jdbc:h2:file:./data/onboarding;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH;AUTO_SERVER=TRUE
# PostgreSQL:     run with SPRING_PROFILES_ACTIVE=postgres and jdbc:postgresql://localhost:5432/onboarding
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- Application users (HTTP Basic). Change these for any shared environment. ---
APP_HR_USERNAME=hr
APP_HR_PASSWORD=change-me-hr
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-admin
APP_ALLOWED_ORIGINS=http://localhost:5173

# --- Workflow policy ---
APP_WORKFLOW_EMAIL_APPROVAL_REQUIRED=false
APP_WORKFLOW_GITHUB_AFTER_EMAIL=true
APP_WORKFLOW_MAX_ATTEMPTS=5

# --- Mock failure injection (development/testing only) ---
APP_MOCK_OPENAI_FAIL=false
APP_MOCK_EMAIL_FAIL=false
APP_MOCK_GITHUB_FAIL=false
