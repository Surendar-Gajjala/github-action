# =============================================================
# Frontend (exposed to the browser bundle). NEVER put secrets in VITE_ variables.
# =============================================================
VITE_RAPIDRATINGS_DATA_API_URL=https://rridata.sandbox.rrilabs.co/v2.0
VITE_RAPIDRATINGS_OUTREACH_API_URL=https://api.sandbox.rrilabs.co
VITE_RAPIDRATINGS_AUTH_URL=https://rridata.sandbox.rrilabs.co/v2.0/oauth/token/
# mock   = synthetic demo data, no network
# proxy  = Vite dev-server proxy obtains the token server-side (npm run dev only)
# direct = browser calls the APIs with a token pasted at runtime (rridata blocks browser CORS)
VITE_RAPIDRATINGS_AUTH_MODE=mock

# =============================================================
# Dev-proxy only (read by vite.config.ts on your machine, NOT bundled)
# =============================================================
RR_CLIENT_ID=
RR_CLIENT_SECRET=
# base64("RR_CLIENT_ID:RR_CLIENT_SECRET"), used by the cURL examples in docs/
RR_BASIC_AUTH=
RR_PORTFOLIO_ID=27070
RR_API_BASE_URL=https://rridata.sandbox.rrilabs.co/v2.0
RR_OUTREACH_BASE_URL=https://api.sandbox.rrilabs.co
RR_TOKEN_URL=https://rridata.sandbox.rrilabs.co/v2.0/oauth/token/
RR_COMPANIES_URL=https://rridata.sandbox.rrilabs.co/v2.0/companies/
RR_PORTFOLIOS_URL=https://rridata.sandbox.rrilabs.co/v2.0/portfolios/
# {rrid} = RapidRatings company ID, substituted at runtime
RR_PERIODS_URL=https://rridata.sandbox.rrilabs.co/v2.0/companies/{rrid}/periods/
RR_RATINGS_URL=https://rridata.sandbox.rrilabs.co/v2.0/companies/{rrid}/ratings/
RR_OUTREACH_URL=https://api.sandbox.rrilabs.co/outreach-requests
