<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_ITEM_PART_CHANGE_APPROVAL" targetNamespace="http://gsr.com/scm/workflows"
                  exporter="scm-workflow" exporterVersion="1.0"
                  modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="ITEM_PART_CHANGE_APPROVAL" name="Item Part Change Approval" isExecutable="true">
    <bpmn:startEvent id="start" name="Change submitted">
      <bpmn:outgoing>Flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="validateItem" name="Validate Item">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-item" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start</bpmn:incoming>
      <bpmn:outgoing>Flow_validate_parts</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="validateParts" name="Validate Part Relationships">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-part-relationships" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_validate_parts</bpmn:incoming>
      <bpmn:outgoing>Flow_to_valid_gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gwValid" name="Valid?" default="Flow_invalid">
      <bpmn:incoming>Flow_to_valid_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="engineeringApproval" name="Engineering Approval">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="ENGINEERING" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_valid</bpmn:incoming>
      <bpmn:outgoing>Flow_eng_decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gwEngineering" name="Engineering decision" default="Flow_eng_rejected">
      <bpmn:incoming>Flow_eng_decision</bpmn:incoming>
      <bpmn:outgoing>Flow_eng_approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_eng_rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gwManagerRequired" name="Manager approval required?" default="Flow_mgr_not_required">
      <bpmn:incoming>Flow_eng_approved</bpmn:incoming>
      <bpmn:outgoing>Flow_mgr_required</bpmn:outgoing>
      <bpmn:outgoing>Flow_mgr_not_required</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="managerApproval" name="Manager Approval">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="MANAGER" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_mgr_required</bpmn:incoming>
      <bpmn:outgoing>Flow_mgr_decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gwManager" name="Manager decision" default="Flow_mgr_rejected">
      <bpmn:incoming>Flow_mgr_decision</bpmn:incoming>
      <bpmn:outgoing>Flow_mgr_approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_mgr_rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="releaseRevision" name="Release Approved Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="release-revision" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_mgr_not_required</bpmn:incoming>
      <bpmn:incoming>Flow_mgr_approved</bpmn:incoming>
      <bpmn:outgoing>Flow_released</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endReleased" name="Revision released">
      <bpmn:incoming>Flow_released</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="recordRejection" name="Record Rejection Reason">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-rejection" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_invalid</bpmn:incoming>
      <bpmn:incoming>Flow_eng_rejected</bpmn:incoming>
      <bpmn:incoming>Flow_mgr_rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_rejected_return</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="returnToEditable" name="Return to Draft or Change Pending">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="return-to-editable" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_rejected_return</bpmn:incoming>
      <bpmn:outgoing>Flow_return_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endRejected" name="Change rejected">
      <bpmn:incoming>Flow_return_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start" sourceRef="start" targetRef="validateItem" />
    <bpmn:sequenceFlow id="Flow_validate_parts" sourceRef="validateItem" targetRef="validateParts" />
    <bpmn:sequenceFlow id="Flow_to_valid_gw" sourceRef="validateParts" targetRef="gwValid" />
    <bpmn:sequenceFlow id="Flow_valid" name="valid" sourceRef="gwValid" targetRef="engineeringApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= validationPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_invalid" name="invalid" sourceRef="gwValid" targetRef="recordRejection" />
    <bpmn:sequenceFlow id="Flow_eng_decision" sourceRef="engineeringApproval" targetRef="gwEngineering" />
    <bpmn:sequenceFlow id="Flow_eng_approved" name="approved" sourceRef="gwEngineering" targetRef="gwManagerRequired">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= lastDecision = &quot;APPROVED&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_eng_rejected" name="rejected" sourceRef="gwEngineering" targetRef="recordRejection" />
    <bpmn:sequenceFlow id="Flow_mgr_required" name="required" sourceRef="gwManagerRequired" targetRef="managerApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= managerApprovalRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_mgr_not_required" name="not required" sourceRef="gwManagerRequired" targetRef="releaseRevision" />
    <bpmn:sequenceFlow id="Flow_mgr_decision" sourceRef="managerApproval" targetRef="gwManager" />
    <bpmn:sequenceFlow id="Flow_mgr_approved" name="approved" sourceRef="gwManager" targetRef="releaseRevision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= lastDecision = &quot;APPROVED&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_mgr_rejected" name="rejected" sourceRef="gwManager" targetRef="recordRejection" />
    <bpmn:sequenceFlow id="Flow_released" sourceRef="releaseRevision" targetRef="endReleased" />
    <bpmn:sequenceFlow id="Flow_rejected_return" sourceRef="recordRejection" targetRef="returnToEditable" />
    <bpmn:sequenceFlow id="Flow_return_end" sourceRef="returnToEditable" targetRef="endRejected" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ITEM_PART_CHANGE_APPROVAL">
    <bpmndi:BPMNPlane id="BPMNPlane_ITEM_PART_CHANGE_APPROVAL" bpmnElement="ITEM_PART_CHANGE_APPROVAL">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="82" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="50" y="224" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="validateItem_di" bpmnElement="validateItem">
        <dc:Bounds x="170" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="validateParts_di" bpmnElement="validateParts">
        <dc:Bounds x="330" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gwValid_di" bpmnElement="gwValid" isMarkerVisible="true">
        <dc:Bounds x="495" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="470" y="231" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="engineeringApproval_di" bpmnElement="engineeringApproval">
        <dc:Bounds x="600" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gwEngineering_di" bpmnElement="gwEngineering" isMarkerVisible="true">
        <dc:Bounds x="765" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="740" y="231" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gwManagerRequired_di" bpmnElement="gwManagerRequired" isMarkerVisible="true">
        <dc:Bounds x="875" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="850" y="231" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="managerApproval_di" bpmnElement="managerApproval">
        <dc:Bounds x="980" y="50" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gwManager_di" bpmnElement="gwManager" isMarkerVisible="true">
        <dc:Bounds x="1145" y="65" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1120" y="121" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="releaseRevision_di" bpmnElement="releaseRevision">
        <dc:Bounds x="1250" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endReleased_di" bpmnElement="endReleased">
        <dc:Bounds x="1422" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1390" y="224" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="recordRejection_di" bpmnElement="recordRejection">
        <dc:Bounds x="600" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="returnToEditable_di" bpmnElement="returnToEditable">
        <dc:Bounds x="780" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endRejected_di" bpmnElement="endRejected">
        <dc:Bounds x="962" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="930" y="404" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_di" bpmnElement="Flow_start">
        <di:waypoint x="118" y="200" />
        <di:waypoint x="170" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_validate_parts_di" bpmnElement="Flow_validate_parts">
        <di:waypoint x="270" y="200" />
        <di:waypoint x="330" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_valid_gw_di" bpmnElement="Flow_to_valid_gw">
        <di:waypoint x="430" y="200" />
        <di:waypoint x="495" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_valid_di" bpmnElement="Flow_valid">
        <di:waypoint x="545" y="200" />
        <di:waypoint x="600" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="542.5" y="178" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_invalid_di" bpmnElement="Flow_invalid">
        <di:waypoint x="520" y="225" />
        <di:waypoint x="520" y="380" />
        <di:waypoint x="600" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="528" y="300" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_eng_decision_di" bpmnElement="Flow_eng_decision">
        <di:waypoint x="700" y="200" />
        <di:waypoint x="765" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_eng_approved_di" bpmnElement="Flow_eng_approved">
        <di:waypoint x="815" y="200" />
        <di:waypoint x="875" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="815" y="178" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_eng_rejected_di" bpmnElement="Flow_eng_rejected">
        <di:waypoint x="790" y="225" />
        <di:waypoint x="790" y="300" />
        <di:waypoint x="650" y="300" />
        <di:waypoint x="650" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="796" y="250" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_mgr_required_di" bpmnElement="Flow_mgr_required">
        <di:waypoint x="900" y="175" />
        <di:waypoint x="900" y="90" />
        <di:waypoint x="980" y="90" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="905" y="70" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_mgr_not_required_di" bpmnElement="Flow_mgr_not_required">
        <di:waypoint x="925" y="200" />
        <di:waypoint x="1250" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1050" y="205" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_mgr_decision_di" bpmnElement="Flow_mgr_decision">
        <di:waypoint x="1080" y="90" />
        <di:waypoint x="1145" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_mgr_approved_di" bpmnElement="Flow_mgr_approved">
        <di:waypoint x="1195" y="90" />
        <di:waypoint x="1300" y="90" />
        <di:waypoint x="1300" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1215" y="70" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_mgr_rejected_di" bpmnElement="Flow_mgr_rejected">
        <di:waypoint x="1170" y="115" />
        <di:waypoint x="1170" y="300" />
        <di:waypoint x="650" y="300" />
        <di:waypoint x="650" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1176" y="250" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_released_di" bpmnElement="Flow_released">
        <di:waypoint x="1350" y="200" />
        <di:waypoint x="1422" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_rejected_return_di" bpmnElement="Flow_rejected_return">
        <di:waypoint x="700" y="380" />
        <di:waypoint x="780" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_return_end_di" bpmnElement="Flow_return_end">
        <di:waypoint x="880" y="380" />
        <di:waypoint x="962" y="380" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
