# Frontend environment for the Enterprise API integration (every view).
# Copy to `.env` (git-ignored) and fill in the token (hosted token, ~24h expiry).

# Same-origin base path the browser calls; the Vite dev proxy forwards it to the hosted
# server. Leave as-is for local dev.
VITE_ENTERPRISE_API_BASE_URL=/enterprise

# Bearer token for the hosted server. Read ONLY by the Vite dev proxy (Node side) and
# injected as the Authorization header — it is NOT prefixed with VITE_, so it never enters
# the browser bundle. Never commit a real value.
ENTERPRISE_API_TOKEN=

# Enterprise origin, e.g. https://<enterprise-host> (https, no path). Read by the Vite dev
# proxy (falls back to the host in vite.config.ts when empty) and by the Netlify Edge
# Function under `netlify dev`. On Netlify, set it in the site's environment variables.
ENTERPRISE_API_HOST=

# RapidRatings (Company details → RapidRatings tab). The browser calls the same-origin
# /rapidratings path; the Vite dev/preview servers (and the Netlify Edge Function) get the
# access token with these client credentials and add it there. NOT prefixed with VITE_, so
# they never enter the browser bundle. Never commit real values.
RAPIDRATINGS_CLIENT_ID=
RAPIDRATINGS_CLIENT_SECRET=
# Optional; defaults to the sandbox, https://rridata.sandbox.rrilabs.co/v2.0
RAPIDRATINGS_API_BASE_URL=
