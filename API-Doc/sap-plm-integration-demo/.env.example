# Copy to .env (never commit .env). Placeholder names only, with no real values.

SERVER_PORT=8080

# mock | real   (real = RealSapBomGatewayPlaceholder, not implemented)
SAP_MODE=mock
# NONE | TRANSIENT_ONCE | ALWAYS_TRANSIENT | PERMANENT
SAP_MOCK_FAILURE_MODE=NONE

# Only for a real adapter. Supply from a secrets manager in real deployments.
SAP_BASE_URL=
SAP_CLIENT=
SAP_USERNAME=
SAP_PASSWORD=

TRANSFER_MAX_ATTEMPTS=3
TRANSFER_BACKOFF_MILLIS=500

SAP_BOM_USAGE=1
SAP_DEFAULT_UNIT=PC
